<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+). Exclude every app data domain from both cloud backup and
     device-to-device transfer. Personal goals are encrypted with a device-bound key and
     must stay on this device; cached public listings are cheap to re-download. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
