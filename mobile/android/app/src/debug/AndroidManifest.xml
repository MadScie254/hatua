<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEBUG BUILDS ONLY: allow plain http:// to the local Django dev server
         (emulator host 10.0.2.2, or localhost via `adb reverse tcp:8000 tcp:8000`).
         Release builds have no network security override, so Android's default
         (cleartext blocked) applies there. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
