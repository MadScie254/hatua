# Export variables via your shell or env manager; Django does NOT load this file automatically. Never commit secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-dev-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# DATABASE_URL=postgresql://hatua:password@localhost:5432/hatua
# Days a staff verification stays valid before a record drops out of the public API (default 90).
# HATUA_VERIFICATION_MAX_AGE_DAYS=90
# Admin path (production uses a non-default value set in Vercel; never commit it).
# DJANGO_ADMIN_URL=admin
# First staff account, created once by build.py / `python manage.py ensure_superuser`.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# Custom domain only (Vercel hosts are added automatically):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.org
# CORS_ALLOWED_ORIGINS=https://your-verified-dashboard-domain.example
# DJANGO_SECURE_SSL_REDIRECT=1
